[Desktop Entry]
Version=1.0
Type=Application
Name=LazyLook
GenericName=Desktop Search
Comment=Instant AI & Hybrid Desktop Search
Exec=lazylook
Icon=lazylook
Terminal=false
Categories=Utility;Filesystem;
Keywords=search;spotlight;find;files;documents;ai;semantic;vector;
StartupNotify=true
StartupWMClass=LazyLook
Actions=Toggle;Preferences;

[Desktop Action Toggle]
Name=Toggle Search Bar
Exec=lazylook --toggle

[Desktop Action Preferences]
Name=Preferences
Exec=lazylook --show
